# Copy this file to ".env" and fill in your key. NEVER commit ".env".
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Models (check https://console.groq.com/docs/models if one is retired)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REWRITE_MODEL=llama-3.1-8b-instant

# Local embedding model (downloaded once from Hugging Face on first run, ~90 MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.25

# Limits
MAX_UPLOAD_MB=10
MAX_CHUNKS_PER_DOC=3000
CHAT_RATE_PER_MIN=30
UPLOAD_RATE_PER_MIN=10

# Browser origins allowed to call the API directly (comma separated).
# Not needed when using the Vite dev proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
